// Testing block expressions
block_magic :: fun () {
    // Yes, blocks can be expressions
    x := {
        x: __int = #ghost;
        if true {
            x = 1;
            yield x;
        } else {
            yield x;
        }
    };
    // { yield x; } = 1;
}



