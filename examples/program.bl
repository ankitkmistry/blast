// Solving struct layouts
A :: struct {
    b: B
}
B :: struct {
    c: C
}
C :: struct {
    a: *A
}

// Solving module and typedef bug
Bax :: FooM.Bar;
FooM :: module {
    Foo : typedef : Bax;
    Bar :: struct {}
}

// Concatenating modules
std :: module {
    stdin : std.io.File;
    stdout: std.io.File;
    stderr: std.io.File;

    io :: module {
        // File operations here
        File :: struct {}
    }
}
std :: module {
    fs :: module {
        // Write here something
    }
}

vec2 :: union {
    struct {
        x: __f64,
        y: __f64,
    },
    v: [2]__f64,
}

vec3 :: union {
    struct {
        union {
            x: __f64,
            r: __f64,
        },
        union {
            y: __f64,
            g: __f64,
        },
        union {
            z: __f64,
            b: __f64,
        },
    },
    struct {
        xy: vec2,
        _: __f64,
    },
    struct {
        _: __f64,
        yz: vec2,
    },
    v: [3]__f64,
}

